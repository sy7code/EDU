{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "frontend-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:demo"
      ],
      "port": 5174
    },
    {
      "name": "frontend-demo-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "vite",
        "frontend",
        "--mode",
        "demo",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}